{
  "name": "stenograma-knowledge-base",
  "productName": "Stenograma KB",
  "version": "0.1.0",
  "private": true,
  "description": "A local knowledge base of Stenograma meetings, email and chats: answers with citations and reply drafts.",
  "author": "oleksandr.pahutiak@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oleksandr-thescimus/stenograma-knowledge-base"
  },
  "main": "./out/main/index.js",
  "desktopName": "stenograma-kb.desktop",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --linux",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "kb": "ELECTRON_RUN_AS_NODE=1 electron core/cli/kb.ts",
    "bench": "ELECTRON_RUN_AS_NODE=1 electron core/cli/bench-search.ts",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "better-sqlite3": "13.0.3",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/google": "^3.0.140",
    "@ai-sdk/groq": "^3.0.80",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ai": "^6.0.320",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "fastify": "5.12.7",
    "globals": "^17.14.0",
    "lucide-react": "1.62.0",
    "markdown-to-jsx": "7.7.17",
    "ollama-ai-provider-v2": "^3.6.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "undici": "7.30.1",
    "unpdf": "^2.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
